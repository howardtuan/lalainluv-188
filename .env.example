# Public template: placeholders only. Never paste real credentials here.
# Run: python scripts/init_env.py (does not overwrite an existing .env).
# Rotate every secret before production. Keep .env and database backups private.
SECRET_KEY=replace-with-a-random-secret-at-least-50-characters-long
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
PORT=8080
SITE_DOMAIN=localhost:8080

# Local database URL; Compose overrides the host with db.
POSTGRES_DB=lalainluv
POSTGRES_USER=lalainluv
POSTGRES_PASSWORD=replace-with-a-random-url-safe-password
DATABASE_URL=postgresql://lalainluv:replace-with-a-random-url-safe-password@127.0.0.1:5432/lalainluv

# Demo catalog is optional and safe to run repeatedly.
SEED_DEMO=True

# Local HTTP. Enable HTTPS and secure cookies when deploying publicly.
SECURE_SSL_REDIRECT=False
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Console backend for local preview; configure SMTP before public launch.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com
ADMIN_EMAIL=admin@example.com
ACCOUNT_EMAIL_VERIFICATION=optional

# Local administrator: bootstrap/sync with manage.py sync_admin; no social binding.
# Use a dedicated ADMIN_EMAIL above. Use a unique password, at least 12 characters.
ADMIN_USERNAME=lalainluv_admin
ADMIN_PASSWORD=replace-with-a-unique-strong-password

# OAuth credentials: leave empty until created in the provider's developer console.
# Do not also configure the same provider via SocialApp in the database.
# At least one provider must be configured before customers can complete binding.
# Callback: https://YOUR_DOMAIN/accounts/google/login/callback/
# Callback: https://YOUR_DOMAIN/accounts/line/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
# True only after LINE has approved permission to request email addresses.
LINE_EMAIL_SCOPE=False
